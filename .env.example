APP_NAME=InvestAI Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=
JWT_SECRET_KEY=
LLM_API_KEY=

MARKET_DATA_SYNC_ENABLED=false
MARKET_DATA_CRON_SECRET=
MARKET_DATA_STOCK_PROVIDER=tejhq
MARKET_DATA_IPO_PROVIDER=xflot
MARKET_DATA_MUTUAL_FUND_PROVIDER=mfapi

TEJHQ_API_BASE_URL=https://api.tejhq.dev
XFLOT_API_BASE_URL=https://www.xflot.com
MFAPI_BASE_URL=https://api.mfapi.in

MARKET_DATA_REQUEST_TIMEOUT=15
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_MAX_CONCURRENCY=5
MARKET_DATA_STOCK_SYNC_LIMIT=500
MARKET_DATA_EOD_LOOKBACK_DAYS=7
MARKET_DATA_MF_DISCOVERY_LIMIT=100
MARKET_DATA_IPO_MAX_RECORDS=100
